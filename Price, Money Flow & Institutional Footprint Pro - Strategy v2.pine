//@version=6
strategy(
     "Price, Money Flow & Institutional Footprint Pro - Strategy v2",
     overlay=true,
     max_labels_count=500,
     max_boxes_count=500,
     max_lines_count=500,
     max_bars_back=500,
     initial_capital=100000,
     pyramiding=0,
     process_orders_on_close=true,
     commission_type=strategy.commission.percent,
     commission_value=0.0)

// ============================================================================
// 1. USER SETTINGS
// ============================================================================

// --------------------------------------------------------------------------
// Volume Engine
// --------------------------------------------------------------------------
volumeMode = input.string(
     "Classic 3x",
     title="Volume Sensitivity",
     options=["Classic 3x", "Strict 4.5x", "Extreme 6x", "Custom"])

customMultiplier = input.float(
     3.0,
     title="Custom Volume Multiplier",
     minval=1.0,
     step=0.25)

vmaLength = input.int(
     20,
     title="Dollar Volume Baseline",
     minval=5,
     maxval=200)

// --------------------------------------------------------------------------
// Risk / Confirmation
// --------------------------------------------------------------------------
atrLength = input.int(
     14,
     title="ATR Length",
     minval=5,
     maxval=100)

atrBufferMultiplier = input.float(
     0.15,
     title="Protected Level ATR Buffer",
     minval=0.01,
     step=0.01)

defenseReactionATR = input.float(
     0.25,
     title="Defended Level Reaction ATR",
     minval=0.05,
     maxval=2.0,
     step=0.05)

confirmationBars = input.int(
     20,
     title="Maximum Confirmation Window",
     minval=1,
     maxval=50)

riskReward = input.float(
     2.5,
     title="Risk / Reward Target",
     minval=0.5,
     step=0.25)

// --------------------------------------------------------------------------
// Entry Quality Guardrails
// --------------------------------------------------------------------------
maxEntryRiskPercent = input.float(
     5.0,
     title="Maximum Entry-to-Stop Risk %",
     minval=0.5,
     maxval=25.0,
     step=0.5)

maxEntryATR = input.float(
     5.0,
     title="Maximum Entry Extension ATR",
     minval=0.5,
     maxval=10.0,
     step=0.25)

// --------------------------------------------------------------------------
// Liquidity
// --------------------------------------------------------------------------
useLiquidityFilter = input.bool(
     false,
     title="Enable Minimum Liquidity Filter")

minimumAvgDollarVolume = input.float(
     1000000,
     title="Minimum Average Dollar Volume",
     minval=0,
     step=100000)

// --------------------------------------------------------------------------
// Session
// --------------------------------------------------------------------------
useSessionFilter = input.bool(
     false,
     title="Use Regular Session Filter")

regularSession = input.session(
     "0930-1600",
     title="Regular Trading Session")

// --------------------------------------------------------------------------
// Strategy Position Sizing
// --------------------------------------------------------------------------
positionSizePercent = input.float(
     10.0,
     title="Position Size % of Equity",
     minval=1.0,
     maxval=100.0,
     step=1.0)

// --------------------------------------------------------------------------
// Chart History
// --------------------------------------------------------------------------
historyMode = input.string(
     "Latest State Only",
     title="Chart History Mode",
     options=["Latest State Only", "Latest Setup", "All History"])

// --------------------------------------------------------------------------
// Display
// --------------------------------------------------------------------------
showTargets = input.bool(
     true,
     title="Show Live Trade Target Zones")

showProtectedLevel = input.bool(
     true,
     title="Show Protected Absorption Level")

showEventLabels = input.bool(
     true,
     title="Show Absorption Event Labels")

showDiagnosticPanel = input.bool(
     true,
     title="Show Diagnostic Panel")

// ============================================================================
// 2. MULTIPLIER ENGINE
// ============================================================================

float volumeMultiplier = switch volumeMode
    "Classic 3x"  => 3.0
    "Strict 4.5x" => 4.5
    "Extreme 6x"  => 6.0
    => customMultiplier

// ============================================================================
// 3. MARKET DATA
// ============================================================================

float dollarVolume = volume * close
float atrValue = ta.atr(atrLength)

bool atrReady =
     not na(atrValue) and
     atrValue > 0

// ============================================================================
// 4. PREVIOUS-BAR DOLLAR VOLUME BASELINE
// ============================================================================

float avgDollarVolumePrevious =
     ta.sma(dollarVolume[1], vmaLength)

float relativeDollarVolume =
     not na(avgDollarVolumePrevious) and
     avgDollarVolumePrevious > 0
         ? dollarVolume / avgDollarVolumePrevious
         : na

bool volumeBaselineReady =
     not na(avgDollarVolumePrevious) and
     avgDollarVolumePrevious > 0

bool marketDataReady =
     not na(open) and
     not na(high) and
     not na(low) and
     not na(close) and
     not na(volume) and
     not na(dollarVolume) and
     dollarVolume > 0

bool dataReady =
     atrReady and
     volumeBaselineReady and
     marketDataReady

// ============================================================================
// 5. FILTERS
// ============================================================================

bool inRegularSession =
     not na(time(timeframe.period, regularSession))

bool sessionAllowed =
     not useSessionFilter or
     inRegularSession

bool liquidityAllowed =
     not useLiquidityFilter or
     (
         volumeBaselineReady and
         avgDollarVolumePrevious >= minimumAvgDollarVolume
     )

// ============================================================================
// 6. EVENT DETECTION
// ============================================================================

bool isAbnormalDollarVolume =
     dataReady and
     not na(relativeDollarVolume) and
     relativeDollarVolume >= volumeMultiplier

bool isRedCandle =
     close < open

bool isPotentialAbsorptionCandle =
     dataReady and
     isAbnormalDollarVolume and
     isRedCandle and
     sessionAllowed and
     liquidityAllowed

// ============================================================================
// 7. STATE MACHINE
// ============================================================================
//
// 0 = IDLE
// 1 = POTENTIAL
// 2 = DEFENDED
// 3 = LONG ACTIVE
// ============================================================================

var int setupState = 0

var int eventBarIndex = na
var int entryBarIndex = na

var float absorptionHigh = na
var float absorptionLow = na
var float absorptionATR = na

var float protectedLevel = na
var float failureLevel = na
var float defenseTriggerLevel = na

var float plannedEntry = na
var float plannedStop = na
var float plannedTarget = na
var float plannedRiskDistance = na
var float plannedRiskPercent = na
var float plannedATRExtension = na

// ============================================================================
// 8. VISUAL OBJECTS
// ============================================================================

var label latestStateLabel = na
var label[] currentSetupLabels = array.new<label>()

var line protectedLine = na
var line entryLine = na
var line stopLine = na
var line targetLine = na

var box targetBox = na

var line[] historicalLines = array.new<line>()
var box[] historicalBoxes = array.new<box>()

// ============================================================================
// 9. CLEANUP HELPERS
// ============================================================================

clearCurrentSetupLabels() =>
    while array.size(currentSetupLabels) > 0
        label lbl = array.pop(currentSetupLabels)
        if not na(lbl)
            label.delete(lbl)

deleteCurrentLines() =>
    if not na(protectedLine)
        line.delete(protectedLine)

    if not na(entryLine)
        line.delete(entryLine)

    if not na(stopLine)
        line.delete(stopLine)

    if not na(targetLine)
        line.delete(targetLine)

deleteCurrentBox() =>
    if not na(targetBox)
        box.delete(targetBox)

// ============================================================================
// 10. NEW SETUP CANDIDATE
// ============================================================================

bool newSetupCandidate =
     isPotentialAbsorptionCandle and
     setupState == 0 and
     strategy.position_size == 0

bool validNewSetup = false

if newSetupCandidate

    float candidateProtectedLevel =
         low

    float candidateAbsorptionATR =
         atrValue

    float candidateFailureLevel =
         candidateProtectedLevel -
         candidateAbsorptionATR * atrBufferMultiplier

    float candidateDefenseTrigger =
         candidateProtectedLevel +
         candidateAbsorptionATR * defenseReactionATR

    bool setupLevelsValid =
         not na(candidateProtectedLevel) and
         not na(candidateAbsorptionATR) and
         candidateAbsorptionATR > 0 and
         not na(candidateFailureLevel) and
         not na(candidateDefenseTrigger) and
         candidateFailureLevel < candidateProtectedLevel and
         candidateDefenseTrigger > candidateProtectedLevel

    if setupLevelsValid

        validNewSetup := true

        // -------------------------------------------------------------------
        // Visual-history cleanup
        // -------------------------------------------------------------------

        if historyMode == "Latest State Only"

            if not na(latestStateLabel)
                label.delete(latestStateLabel)
                latestStateLabel := na

            clearCurrentSetupLabels()
            deleteCurrentLines()
            deleteCurrentBox()

            protectedLine := na
            entryLine := na
            stopLine := na
            targetLine := na
            targetBox := na

        else if historyMode == "Latest Setup"

            clearCurrentSetupLabels()
            deleteCurrentLines()
            deleteCurrentBox()

            protectedLine := na
            entryLine := na
            stopLine := na
            targetLine := na
            targetBox := na

        else

            if not na(protectedLine)
                array.push(historicalLines, protectedLine)

            if not na(entryLine)
                array.push(historicalLines, entryLine)

            if not na(stopLine)
                array.push(historicalLines, stopLine)

            if not na(targetLine)
                array.push(historicalLines, targetLine)

            if not na(targetBox)
                array.push(historicalBoxes, targetBox)

            protectedLine := na
            entryLine := na
            stopLine := na
            targetLine := na
            targetBox := na

        // -------------------------------------------------------------------
        // Activate setup
        // -------------------------------------------------------------------

        setupState := 1

        eventBarIndex := bar_index
        entryBarIndex := na

        absorptionHigh := high
        absorptionLow := low
        absorptionATR := candidateAbsorptionATR

        protectedLevel := candidateProtectedLevel
        failureLevel := candidateFailureLevel
        defenseTriggerLevel := candidateDefenseTrigger

        plannedEntry := na
        plannedStop := na
        plannedTarget := na

        plannedRiskDistance := na
        plannedRiskPercent := na
        plannedATRExtension := na

        if showProtectedLevel

            protectedLine := line.new(
                 x1=bar_index,
                 y1=protectedLevel,
                 x2=bar_index + confirmationBars,
                 y2=protectedLevel,
                 color=color.orange,
                 style=line.style_dashed,
                 width=2)

// ============================================================================
// 11. POTENTIAL LABEL
// ============================================================================

if validNewSetup and showEventLabels

    string eventText =
         "POTENTIAL BLOCK ABSORPTION\n" +
         "RVOL$: " +
         str.format("{0,number,#.##}x", relativeDollarVolume) +
         "\nDollar Vol: $" +
         str.format("{0,number,#.##}M", dollarVolume / 1000000) +
         "\nProtected: $" +
         str.format("{0,number,#.##}", protectedLevel) +
         "\nFailure: $" +
         str.format("{0,number,#.##}", failureLevel) +
         "\nDefense > $" +
         str.format("{0,number,#.##}", defenseTriggerLevel)

    label lbl = label.new(
         bar_index,
         high + atrValue * 0.65,
         eventText,
         yloc=yloc.price,
         style=label.style_label_down,
         color=color.orange,
         textcolor=color.black,
         size=size.small)

    if historyMode == "Latest State Only"
        latestStateLabel := lbl

    else if historyMode == "Latest Setup"
        array.push(currentSetupLabels, lbl)

// ============================================================================
// 12. SETUP AGE
// ============================================================================

int barsSinceEvent =
     not na(eventBarIndex)
         ? bar_index - eventBarIndex
         : na

// ============================================================================
// 13. FAILURE
// ============================================================================

bool absorptionFailed =
     (setupState == 1 or setupState == 2) and
     not na(failureLevel) and
     close < failureLevel

if absorptionFailed

    if showEventLabels

        if historyMode == "Latest State Only"

            if not na(latestStateLabel)
                label.delete(latestStateLabel)
                latestStateLabel := na

        label lbl = label.new(
             bar_index,
             high + atrValue * 0.85,
             "ABSORPTION FAILED\nProtected Level Broken",
             yloc=yloc.price,
             style=label.style_label_down,
             color=color.gray,
             textcolor=color.white,
             size=size.small)

        if historyMode == "Latest State Only"
            latestStateLabel := lbl

        else if historyMode == "Latest Setup"
            array.push(currentSetupLabels, lbl)

    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)

    setupState := 0

    eventBarIndex := na

    absorptionHigh := na
    absorptionLow := na
    absorptionATR := na

    protectedLevel := na
    failureLevel := na
    defenseTriggerLevel := na

// ============================================================================
// 14. DEFENDED LEVEL
// ============================================================================

float candleRange =
     high - low

bool closeInUpperHalf =
     candleRange > 0 and
     close >= low + candleRange * 0.50

bool bullishReaction =
     close > open

bool reactionDistanceReached =
     not na(defenseTriggerLevel) and
     close >= defenseTriggerLevel

bool strongDefenseReaction =
     setupState == 1 and
     not na(eventBarIndex) and
     bar_index > eventBarIndex and
     bullishReaction and
     closeInUpperHalf and
     reactionDistanceReached and
     not na(failureLevel) and
     close >= failureLevel

if strongDefenseReaction

    setupState := 2

    if showEventLabels

        if historyMode == "Latest State Only"

            if not na(latestStateLabel)
                label.delete(latestStateLabel)
                latestStateLabel := na

        label lbl = label.new(
             bar_index,
             low - atrValue * 0.45,
             "BLOCK LEVEL DEFENDED\nBullish Reaction Confirmed",
             yloc=yloc.price,
             style=label.style_label_up,
             color=color.orange,
             textcolor=color.white,
             size=size.small)

        if historyMode == "Latest State Only"
            latestStateLabel := lbl

        else if historyMode == "Latest Setup"
            array.push(currentSetupLabels, lbl)

// ============================================================================
// 15. STRUCTURAL CONFIRMATION
// ============================================================================

bool confirmationWindowOpen =
     setupState == 2 and
     not na(barsSinceEvent) and
     barsSinceEvent >= 1 and
     barsSinceEvent <= confirmationBars

bool bullishConfirmationCandle =
     close > open

bool breaksAbsorptionHigh =
     not na(absorptionHigh) and
     close > absorptionHigh

bool absorptionConfirmed =
     confirmationWindowOpen and
     bullishConfirmationCandle and
     breaksAbsorptionHigh

// ============================================================================
// 16. CANDIDATE TRADE
// ============================================================================

float candidateEntry =
     absorptionConfirmed
         ? close
         : na

float candidateStop =
     absorptionConfirmed and
     not na(protectedLevel) and
     not na(absorptionATR)
         ? protectedLevel -
           absorptionATR * atrBufferMultiplier
         : na

float candidateRiskDistance =
     absorptionConfirmed and
     not na(candidateEntry) and
     not na(candidateStop)
         ? candidateEntry - candidateStop
         : na

bool candidateRiskValid =
     absorptionConfirmed and
     not na(candidateRiskDistance) and
     candidateRiskDistance > 0

float candidateRiskPercent =
     candidateRiskValid and
     candidateEntry > 0
         ? (candidateRiskDistance / candidateEntry) * 100
         : na

float candidateATRExtension =
     candidateRiskValid and
     not na(absorptionATR) and
     absorptionATR > 0
         ? candidateRiskDistance / absorptionATR
         : na

float candidateTarget =
     candidateRiskValid
         ? candidateEntry +
           candidateRiskDistance * riskReward
         : na

bool candidateTradeValid =
     candidateRiskValid and
     not na(candidateEntry) and
     not na(candidateStop) and
     not na(candidateTarget)

bool riskPercentAcceptable =
     candidateTradeValid and
     not na(candidateRiskPercent) and
     candidateRiskPercent <= maxEntryRiskPercent

bool atrExtensionAcceptable =
     candidateTradeValid and
     not na(candidateATRExtension) and
     candidateATRExtension <= maxEntryATR

bool entryQualityAccepted =
     candidateTradeValid and
     riskPercentAcceptable and
     atrExtensionAcceptable

bool entryTooExtended =
     candidateTradeValid and
     not entryQualityAccepted

bool invalidTradeCalculation =
     absorptionConfirmed and
     not candidateTradeValid

// ============================================================================
// 17. INVALID TRADE
// ============================================================================

if invalidTradeCalculation

    if showEventLabels

        if historyMode == "Latest State Only"

            if not na(latestStateLabel)
                label.delete(latestStateLabel)
                latestStateLabel := na

        label lbl = label.new(
             bar_index,
             high + atrValue * 0.85,
             "ABSORPTION CONFIRMED\nINVALID TRADE CALCULATION",
             yloc=yloc.price,
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small)

        if historyMode == "Latest State Only"
            latestStateLabel := lbl

        else if historyMode == "Latest Setup"
            array.push(currentSetupLabels, lbl)

    setupState := 0
    eventBarIndex := na

// ============================================================================
// 18. EXTENDED ENTRY REJECTION
// ============================================================================

if entryTooExtended

    if showEventLabels

        if historyMode == "Latest State Only"

            if not na(latestStateLabel)
                label.delete(latestStateLabel)
                latestStateLabel := na

        string rejectText =
             "ABSORPTION CONFIRMED\n" +
             "ENTRY REJECTED - TOO EXTENDED\n" +
             "Risk: " +
             str.format("{0,number,#.##}%", candidateRiskPercent) +
             "\nMax Risk: " +
             str.format("{0,number,#.##}%", maxEntryRiskPercent) +
             "\nATR Extension: " +
             str.format("{0,number,#.##}x", candidateATRExtension) +
             "\nMax ATR: " +
             str.format("{0,number,#.##}x", maxEntryATR)

        label lbl = label.new(
             bar_index,
             high + atrValue * 0.85,
             rejectText,
             yloc=yloc.price,
             style=label.style_label_down,
             color=color.gray,
             textcolor=color.white,
             size=size.small)

        if historyMode == "Latest State Only"
            latestStateLabel := lbl

        else if historyMode == "Latest Setup"
            array.push(currentSetupLabels, lbl)

    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)

    setupState := 0
    eventBarIndex := na

// ============================================================================
// 19. LONG ENTRY
// ============================================================================

bool longSignal =
     entryQualityAccepted and
     strategy.position_size == 0

if longSignal

    plannedEntry := candidateEntry
    plannedStop := candidateStop
    plannedTarget := candidateTarget

    plannedRiskDistance := candidateRiskDistance
    plannedRiskPercent := candidateRiskPercent
    plannedATRExtension := candidateATRExtension

    entryBarIndex := bar_index
    setupState := 3

    float orderValue =
         strategy.equity *
         (positionSizePercent / 100.0)

    float qty =
         orderValue / plannedEntry

    strategy.entry(
         "Long",
         strategy.long,
         qty=qty)

    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)

    entryLine := line.new(
         x1=bar_index,
         y1=plannedEntry,
         x2=bar_index + 10,
         y2=plannedEntry,
         color=color.green,
         width=1)

    stopLine := line.new(
         x1=bar_index,
         y1=plannedStop,
         x2=bar_index + 10,
         y2=plannedStop,
         color=color.red,
         width=2)

    targetLine := line.new(
         x1=bar_index,
         y1=plannedTarget,
         x2=bar_index + 10,
         y2=plannedTarget,
         color=color.green,
         width=2)

// ============================================================================
// 20. LONG LABEL
// ============================================================================

if longSignal and showEventLabels

    if historyMode == "Latest State Only"

        if not na(latestStateLabel)
            label.delete(latestStateLabel)
            latestStateLabel := na

    string longText =
         "BLOCK ABSORPTION CONFIRMED\n" +
         "LONG\n" +
         "Entry: $" +
         str.format("{0,number,#.##}", plannedEntry) +
         "\nStop: $" +
         str.format("{0,number,#.##}", plannedStop) +
         "\nRisk: " +
         str.format("{0,number,#.##}%", plannedRiskPercent) +
         "\nATR Ext: " +
         str.format("{0,number,#.##}x", plannedATRExtension) +
         "\nTarget (" +
         str.format("{0,number,#.##}", riskReward) +
         "R): $" +
         str.format("{0,number,#.##}", plannedTarget)

    label lbl = label.new(
         bar_index,
         low - atrValue * 0.70,
         longText,
         yloc=yloc.price,
         style=label.style_label_up,
         color=color.green,
         textcolor=color.white,
         size=size.normal)

    if historyMode == "Latest State Only"
        latestStateLabel := lbl

    else if historyMode == "Latest Setup"
        array.push(currentSetupLabels, lbl)

// ============================================================================
// 21. SETUP EXPIRATION
// ============================================================================

bool setupExpired =
     (setupState == 1 or setupState == 2) and
     not na(barsSinceEvent) and
     barsSinceEvent > confirmationBars

if setupExpired

    string expirationReason =
         setupState == 1
             ? "ABSORPTION EXPIRED\nDefense Never Confirmed"
             : "ABSORPTION EXPIRED\nNo Break Above $" +
               str.format("{0,number,#.##}", absorptionHigh)

    if showEventLabels

        if historyMode == "Latest State Only"

            if not na(latestStateLabel)
                label.delete(latestStateLabel)
                latestStateLabel := na

        label lbl = label.new(
             bar_index,
             high + atrValue,
             expirationReason,
             yloc=yloc.price,
             style=label.style_label_down,
             color=color.gray,
             textcolor=color.white,
             size=size.small)

        if historyMode == "Latest State Only"
            latestStateLabel := lbl

        else if historyMode == "Latest Setup"
            array.push(currentSetupLabels, lbl)

    if not na(protectedLine)
        line.set_x2(protectedLine, bar_index)

    setupState := 0
    eventBarIndex := na

// ============================================================================
// 22. STRATEGY EXIT
// ============================================================================
//
// Entry is assumed at confirmation-bar close.
// Stop and target are activated from the NEXT candle.
// ============================================================================

bool tradeActive =
     setupState == 3 and
     strategy.position_size > 0

bool exitOrdersActive =
     tradeActive and
     not na(entryBarIndex) and
     bar_index > entryBarIndex and
     not na(plannedStop) and
     not na(plannedTarget)

if exitOrdersActive

    strategy.exit(
         "Long Exit",
         from_entry="Long",
         stop=plannedStop,
         limit=plannedTarget)

// ============================================================================
// 23. LIVE TRADE GRAPHICS
// ============================================================================

if tradeActive

    if not na(entryLine)
        line.set_x2(entryLine, bar_index + 2)

    if not na(stopLine)
        line.set_x2(stopLine, bar_index + 2)

    if not na(targetLine)
        line.set_x2(targetLine, bar_index + 2)

    if showTargets

        if na(targetBox)

            targetBox := box.new(
                 left=entryBarIndex,
                 top=plannedTarget,
                 right=bar_index + 10,
                 bottom=plannedStop,
                 bgcolor=color.new(color.green, 90),
                 border_color=color.green,
                 border_style=line.style_dashed,
                 text=
                     "CONFIRMED BLOCK ABSORPTION\n" +
                     "Entry: $" +
                     str.format("{0,number,#.##}", plannedEntry) +
                     "\nStop: $" +
                     str.format("{0,number,#.##}", plannedStop) +
                     "\nTarget: $" +
                     str.format("{0,number,#.##}", plannedTarget),
                 text_color=color.white,
                 text_size=size.small,
                 text_valign="center",
                 text_halign="center")

        else

            box.set_right(
                 targetBox,
                 bar_index + 10)

// ============================================================================
// 24. CURRENT R
// ============================================================================

float currentR =
     tradeActive and
     not na(plannedRiskDistance) and
     plannedRiskDistance > 0
         ? (close - plannedEntry) /
           plannedRiskDistance
         : na

// ============================================================================
// 25. TRADE COMPLETION
// ============================================================================

bool tradeClosed =
     setupState == 3 and
     strategy.position_size == 0 and
     not longSignal

if tradeClosed

    if not na(entryLine)
        line.set_x2(entryLine, bar_index)

    if not na(stopLine)
        line.set_x2(stopLine, bar_index)

    if not na(targetLine)
        line.set_x2(targetLine, bar_index)

    if not na(targetBox)
        box.set_right(targetBox, bar_index)

    setupState := 0

    eventBarIndex := na
    entryBarIndex := na

    absorptionHigh := na
    absorptionLow := na
    absorptionATR := na

    protectedLevel := na
    failureLevel := na
    defenseTriggerLevel := na

    plannedEntry := na
    plannedStop := na
    plannedTarget := na

    plannedRiskDistance := na
    plannedRiskPercent := na
    plannedATRExtension := na

// ============================================================================
// 26. DIAGNOSTIC PANEL
// ============================================================================

var table diagnostics =
     table.new(
         position.top_right,
         2,
         16,
         border_width=1)

string stateText = switch setupState
    0 => "IDLE"
    1 => "POTENTIAL"
    2 => "DEFENDED"
    3 => "LONG ACTIVE"
    => "UNKNOWN"

string dataReadyText =
     dataReady ? "YES" : "NO"

string sessionText =
     sessionAllowed ? "YES" : "NO"

string liquidityText =
     liquidityAllowed ? "YES" : "NO"

string rvolText =
     not na(relativeDollarVolume)
         ? str.format("{0,number,#.##}x", relativeDollarVolume)
         : "N/A"

string requiredText =
     str.format("{0,number,#.##}x", volumeMultiplier)

string barsText =
     not na(barsSinceEvent)
         ? str.tostring(barsSinceEvent)
         : "-"

string protectedText =
     not na(protectedLevel)
         ? str.format("${0,number,#.##}", protectedLevel)
         : "-"

string failureText =
     not na(failureLevel)
         ? str.format("${0,number,#.##}", failureLevel)
         : "-"

string defenseText =
     not na(defenseTriggerLevel)
         ? str.format("${0,number,#.##}", defenseTriggerLevel)
         : "-"

string confirmationText =
     not na(absorptionHigh)
         ? str.format("${0,number,#.##}", absorptionHigh)
         : "-"

string entryText =
     tradeActive
         ? str.format("${0,number,#.##}", plannedEntry)
         : "-"

string stopText =
     tradeActive
         ? str.format("${0,number,#.##}", plannedStop)
         : "-"

string targetText =
     tradeActive
         ? str.format("${0,number,#.##}", plannedTarget)
         : "-"

string riskText =
     tradeActive
         ? str.format("{0,number,#.##}%", plannedRiskPercent)
         : "-"

string atrExtensionText =
     tradeActive
         ? str.format("{0,number,#.##}x", plannedATRExtension)
         : "-"

string currentRText =
     tradeActive and
     not na(currentR)
         ? str.format("{0,number,#.##}R", currentR)
         : "-"

if barstate.islast

    if showDiagnosticPanel

        table.cell(diagnostics, 0, 0, "STATE")
        table.cell(diagnostics, 1, 0, stateText)

        table.cell(diagnostics, 0, 1, "Data Ready")
        table.cell(diagnostics, 1, 1, dataReadyText)

        table.cell(diagnostics, 0, 2, "RVOL$")
        table.cell(diagnostics, 1, 2, rvolText)

        table.cell(diagnostics, 0, 3, "Required")
        table.cell(diagnostics, 1, 3, requiredText)

        table.cell(diagnostics, 0, 4, "Session")
        table.cell(diagnostics, 1, 4, sessionText)

        table.cell(diagnostics, 0, 5, "Liquidity")
        table.cell(diagnostics, 1, 5, liquidityText)

        table.cell(diagnostics, 0, 6, "Bars Since Event")
        table.cell(diagnostics, 1, 6, barsText)

        table.cell(diagnostics, 0, 7, "Protected")
        table.cell(diagnostics, 1, 7, protectedText)

        table.cell(diagnostics, 0, 8, "Failure")
        table.cell(diagnostics, 1, 8, failureText)

        table.cell(diagnostics, 0, 9, "Defense >")
        table.cell(diagnostics, 1, 9, defenseText)

        table.cell(diagnostics, 0, 10, "Confirm >")
        table.cell(diagnostics, 1, 10, confirmationText)

        table.cell(diagnostics, 0, 11, "Entry")
        table.cell(diagnostics, 1, 11, entryText)

        table.cell(diagnostics, 0, 12, "Stop")
        table.cell(diagnostics, 1, 12, stopText)

        table.cell(diagnostics, 0, 13, "Target")
        table.cell(diagnostics, 1, 13, targetText)

        table.cell(diagnostics, 0, 14, "Entry Risk / ATR")
        table.cell(
             diagnostics,
             1,
             14,
             riskText + " / " + atrExtensionText)

        table.cell(diagnostics, 0, 15, "Current R")
        table.cell(diagnostics, 1, 15, currentRText)

    else

        table.clear(
             diagnostics,
             0,
             0,
             1,
             15)

// ============================================================================
// 27. ALERTS
// ============================================================================

alertcondition(
     validNewSetup,
     title="Potential Block Absorption",
     message="Valid Potential Block Absorption detected.")

alertcondition(
     strongDefenseReaction,
     title="Block Level Defended",
     message="Block Absorption protected level defended.")

alertcondition(
     entryTooExtended,
     title="Entry Rejected",
     message="Block Absorption confirmed but entry rejected because risk/ATR extension is too large.")

alertcondition(
     longSignal,
     title="Long Entry",
     message="Block Absorption confirmed and LONG entry triggered.")

alertcondition(
     absorptionFailed,
     title="Block Absorption Failed",
     message="Protected Block Absorption level failed.")